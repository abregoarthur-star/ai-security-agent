PORT=3100

# Callers. With neither set, every protected route answers 503.
# AGENT_API_KEYS=brain:<key>,security-agent:<key>
AGENT_API_KEYS=
# One shared key, known as caller "legacy" (being replaced by AGENT_API_KEYS)
AGENT_API_KEY=
# Optional: narrow what a caller may use. Unlisted callers may use everything.
# CALLER_CAPABILITIES=security-agent=intel|posture
CALLER_CAPABILITIES=

BRAIN_API_URL=https://abstract-ai-brain-production.up.railway.app
BRAIN_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Persistence. Railway: DATA_DIR=/data with a volume mounted there.
DATA_DIR=
# Server-side manifest files a caller may name. Default: <data dir>/manifests
MANIFEST_ROOT=

# stdio audits run a command on this server. Off unless ALLOW_STDIO_AUDIT=1,
# and then only for the complete command lines listed (comma-separated).
ALLOW_STDIO_AUDIT=
STDIO_ALLOWLIST=

# run_self_test spends money. Per-run caps and a daily cap across all runs (defaults shown).
# SELF_TEST_MAX_ROUNDS=30
# SELF_TEST_MAX_COST_USD_PER_GEN=1.50
# SELF_TEST_DAILY_CAP_USD=3.00
# SELF_TEST_MODEL_ALLOWLIST=claude-sonnet-5-5,claude-haiku-5-5,llama-3.3-70b-versatile,llama-3.1-8b-instant,meta-llama/llama-4-scout-17b-16e-instruct
